				<WorkToMake>10</WorkToMake>
				<Quality>0</Quality>
			</BeMade>
			<ProduceKind>Handwork</ProduceKind>
		</Building>
		<StoryBnts>
			<li Name="兑换" Desc="打开兑换界面" Script="GameMain:GetMod('Windows'):GetWindow('JYSUIWindow'):ShowView(bind)" Icon="res/Sprs/ui/icon_hand"/>
		</StoryBnts>
	</ThingDef>
</List></ThingDefs>
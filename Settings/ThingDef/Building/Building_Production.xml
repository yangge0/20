		<TexPath>Spr\Building\ExchangePlace.png</TexPath>
		<SelectAble>1</SelectAble>
		<CastShadow>0</CastShadow>
		<Beauty>12</Beauty>
		<BlockLight>0</BlockLight>
		<MaxHitPoints>1</MaxHitPoints>
